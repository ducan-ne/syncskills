{
  "name": "agentskillsync",
  "version": "0.2.0",
  "description": "Sync ~/.agents skills (source of truth) one-way into Claude Code, Codex, Antigravity, Aside, and other harnesses",
  "type": "module",
  "bin": {
    "agentskillsync": "dist/cli.js",
    "syncskills": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/cli.ts --outdir dist --target node --minify",
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "prepublishOnly": "bun run test && bun run build"
  },
  "keywords": [
    "sync",
    "agents",
    "skills",
    "claude",
    "codex",
    "antigravity",
    "aside",
    "cli",
    "symlink",
    "agents.md"
  ],
  "author": "ducan-ne",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ducan-ne/syncskills.git"
  },
  "bugs": {
    "url": "https://github.com/ducan-ne/syncskills/issues"
  },
  "homepage": "https://github.com/ducan-ne/syncskills#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
